# =============================================================================
# Multistack Hire — Production (.env.prod) template
# Copy to `.env.prod` on the server, fill secrets, then run ./deploy/up.sh
# =============================================================================

# ── Site / TLS (Caddy) ───────────────────────────────────────────────────────
DOMAIN=multistackhire.manashdevbhatta.com.np
ACME_EMAIL=admin@manashdevbhatta.com.np

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=multistack-hire

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=msh_user
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=multistack_hire
DATABASE_URL=postgresql+asyncpg://msh_user:change-me-strong-db-password@db:5432/multistack_hire
DATABASE_SSL=false

# ── JWT / auth ───────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://multistackhire.manashdevbhatta.com.np
CORS_ORIGIN_REGEX=

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=msh_minio
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_BUCKET_NAME=multistack-hire-resumes
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=msh_minio
MINIO_SECRET_KEY=change-me-strong-minio-password
MINIO_PUBLIC_ENDPOINT=storage.multistackhire.manashdevbhatta.com.np
MINIO_PUBLIC_SECURE=true

# ── Seeded admin ─────────────────────────────────────────────────────────────
SEED_ADMIN=true
SEED_ADMIN_EMAIL=admin@multistackhire.com
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_FULL_NAME="System Admin"
