# Backend origin only (no /api/v1 suffix — the client appends that).
# Local development:
VITE_API_URL=http://localhost:8000

# Production example (set the same value as a GitHub Actions repository variable):
# VITE_API_URL=https://multistack-hire.onrender.com

# Vite asset base path (build-time). Local: omit (defaults to /).
# GitHub Actions / custom domain: ./
# VITE_BASE_PATH=./

# React Router basename. Custom domain at root: leave empty.
# github.io project site only: /multistack-hire
# VITE_ROUTER_BASENAME=
