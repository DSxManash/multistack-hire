# Frontend API base URL for local development.
# Keep this as the backend host; the axios client adds /api/v1.
VITE_API_URL=http://localhost:8000

# Vite asset base path (build-time only).
# Local dev: omit (defaults to /).
# GitHub Actions / custom domain: ./
# github.io project site only: /multistack-hire/
# VITE_BASE_PATH=./

# React Router basename (must match where the app is hosted, not where assets live).
# Custom domain at root: leave empty.
# github.io project site: /multistack-hire
# VITE_ROUTER_BASENAME=
