# =============================================================================
# Multistack Hire — Backend (FastAPI)
# =============================================================================
# Copy to .env and fill in values. On Render, set the same keys in the dashboard.
# =============================================================================

# Supabase: Project Settings → Database → Connection string → URI
# Use the "Transaction" pooler URI (port 6543) for serverless/web apps, or
# Session mode / direct (port 5432) if you prefer.
# Paste as-is (postgres:// or postgresql://). The app converts to asyncpg.
#
# Example:
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname

# SSL for Supabase must be on. Keep auto (or set true).
# The app encrypts with TLS but does not fail on provider cert chains.
DATABASE_SSL=auto

SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_ENV=production

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://multistackhire.manashdevbhatta.com.np,https://dsxmanash.github.io
CORS_ORIGIN_REGEX=https://.*\.github\.io

# MinIO (optional locally)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=multistack-hire-resumes
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
