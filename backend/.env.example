# Database connection URL for SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname

SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# development | production
APP_ENV=development

# Comma-separated browser origins allowed to call the API (CORS).
# Exact match, no trailing slash. Must include your live frontend URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://multistackhire.manashdevbhatta.com.np,https://dsxmanash.github.io

# Optional regex for additional origins (GitHub Pages project sites, etc.)
CORS_ORIGIN_REGEX=https://.*\.github\.io

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=multistack-hire-resumes
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
