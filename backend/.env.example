# Database
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db:5432/multistack_hire

# JWT
SECRET_KEY=generate-with-secrets.token_urlsafe(32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
APP_NAME=multistack-hire

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-password
MINIO_BUCKET_NAME=multistack-hire-resumes
MINIO_SECURE=false

# GitHub API
# Get free token: https://github.com/settings/tokens
# No scopes needed for public data
# Without token: 60 req/hour | With token: 5000 req/hour
GITHUB_API_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_TIMEOUT=15

# LeetCode (unofficial GraphQL)
# Warning: may be blocked from server IPs
# Fallback to 0 values if unavailable
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
LEETCODE_API_TIMEOUT=15