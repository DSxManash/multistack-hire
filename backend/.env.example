# Database
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db:5432/multistack_hire

# JWT
SECRET_KEY=generate-with-secrets.token_urlsafe(32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
APP_NAME=multistack-hire

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-password
MINIO_BUCKET_NAME=multistack-hire-resumes
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Browser-facing host for presigned URLs (Caddy storage subdomain in prod)
# MINIO_PUBLIC_ENDPOINT=storage.multistackhire.manashdevbhatta.com.np
# MINIO_PUBLIC_SECURE=true
